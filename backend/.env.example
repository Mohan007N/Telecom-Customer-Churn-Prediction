# Churn Predictor — FastAPI Backend Environment Configuration
APP_NAME="Churn Predictor API"
APP_VERSION="1.0.0"
API_PREFIX="/api/v1"

HOST="0.0.0.0"
PORT=8000
DEBUG=false

CORS_ORIGINS="*"
RATE_LIMIT_MAX_REQUESTS=180
RATE_LIMIT_WINDOW_SECONDS=60
MAX_UPLOAD_SIZE_BYTES=10485760

DEFAULT_THRESHOLD=0.5

# Model Artifact Paths (leave blank or specify custom paths)
# RAW_DATA_PATH=../WA_Fn-UseC_-Telco-Customer-Churn.csv
# MODEL_PATH=../models/xgboost_churn_model.pkl
# SCALER_PATH=../models/scaler.pkl
# META_PATH=../models/feature_metadata.json
# METRICS_PATH=../reports/metrics.json

# Output directory for downloadable batch CSV results
OUTPUT_DIR="temp_downloads"
